# Security: Prevent committing sensitive files

# Environment variables and secrets
.env
.env.*
*.key
*.pem
*.p12
*.pfx
credentials.json
secrets.json
secret.yaml
config/secrets.*

# API keys and tokens
**/api_keys.txt
**/tokens.txt
**/*secret*
**/*password*
**/*credentials*

# Cloud provider credentials
.aws/
.azure/
.gcloud/

# SSH keys
id_rsa
id_dsa
id_ecdsa
id_ed25519
*.pub

# Database files (may contain sensitive data)
*.db
*.sqlite
*.sqlite3

# Logs (may contain sensitive information)
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Dependency directories
node_modules/
venv/
env/
__pycache__/
*.pyc

# Build outputs
dist/
build/
*.egg-info/
target/

# Temporary files
tmp/
temp/
*.tmp
